# ====================================
# Variables de Entorno para React SPA
# ====================================

# URL de la API Laravel
# En desarrollo local (sin Docker)
VITE_API_URL=http://localhost:8000/api

# En producción con Docker (usa el nombre del servicio)
# VITE_API_URL=http://backend:8000/api

# En producción con dominio real
# VITE_API_URL=https://api.tudominio.com/api

# ====================================
# Otras variables (si las necesitas)
# ====================================

# VITE_APP_NAME=Blog SPA
# VITE_APP_VERSION=1.0.0
