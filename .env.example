# ====================================
# Variables de Entorno para React SPA
# ====================================

# URL de la API Laravel
# En desarrollo local (sin Docker)
VITE_API_URL=http://localhost:8000/api

# En producción con Docker (usa el nombre del servicio)
# VITE_API_URL=http://backend:8000/api

# En producción con dominio real
# VITE_API_URL=https://api.tudominio.com/api

# ====================================
# Auth0 Configuration
# ====================================

# Tu dominio de Auth0 (ej: dev-abc123.us.auth0.com)
VITE_AUTH0_DOMAIN=your-tenant.auth0.com

# Client ID de tu aplicación Auth0
VITE_AUTH0_CLIENT_ID=your-client-id

# API Audience (opcional, para APIs protegidas)
VITE_AUTH0_AUDIENCE=https://your-api-identifier

# Redirect URI después del login
# En desarrollo
VITE_AUTH0_REDIRECT_URI=http://localhost:3000
# En producción con Docker
# VITE_AUTH0_REDIRECT_URI=http://localhost:3000

# ====================================
# Otras variables (si las necesitas)
# ====================================

# VITE_APP_NAME=Blog SPA
# VITE_APP_VERSION=1.0.0
